---
import Layout from "../layouts/Layout.astro";
---

<style>
  .main {
    flex: 1;
    padding: 32px 36px;
    display: flex;
    flex-direction: column;
    gap: 18px;
  }
  .main h1 {
    font-size: 1.5rem;
    margin: 0 0 8px 0;
    font-weight: 600;
  }
  .tasks {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
    cursor: pointer;
  }
  .task {
    background: #f6f8fa;
    border-radius: 6px;
    padding: 10px 14px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 1.05rem;
    box-shadow: 0 1px 2px #0001;
    transition: background 0.45s;
  }
  .task:hover {
    background: #c3c6c99e;
  }
  .task.completed {
    text-decoration: line-through;
    color: #aaa;
    background: #e6e8eb;
    cursor: pointer;
  }
  .task.task.completed:hover {
    background: #abaeb09e;
  }

  .remove-task {
    background: none;
    border: none;
    color: #e74c3c;
    font-size: 1.1em;
    cursor: pointer;
    margin-left: 8px;
  }
  .clear {
    color: white;
    padding: 10px 18px;
    border-radius: 6px;
    background-color: #e74c3c;
    cursor: pointer;
    transition: background 0.45s;
  }

  .clear:hover {
    background-color: #ab3326;
  }
  .tasks li {
    position: relative;
  }
  .edit-task {
    opacity: 0;
    transition: opacity 0.2s;
    background: none;
    border: none;
    cursor: pointer;
    font-size: 1.1rem;
  }
  .tasks li:hover .edit-task,
  .tasks li:focus-within .edit-task {
    opacity: 1;
  }
</style>

<Layout>
  <div class="grid place-content-center">
    <div class="rounded m-2 flex border">
      <aside class="p-2 w-48 gap-4 flex flex-col bg-background-2 shadow">
        <h2 class="font-bold text-2xl">Lists</h2>
        <button class="p-2 rounded bg-button font-bold" id="add-list-btn"
          >+ New List</button
        >
        <div class="flex flex-col gap-2" id="lists"></div>
      </aside>

      <main class="main bg-background-2 shadow">
        <h1 id="list-title">To-Do</h1>
        <form class="" id="add-task-form" autocomplete="off">
          <label for="task-input">Task Name: </label>
          <input
            type="text"
            id="task-input"
            placeholder="Math Homework"
            required
          />
          <button type="submit">Add</button>
        </form>
        <ul class="tasks" id="tasks"></ul>
        <button class="clear" id="clear-all-btn">Clear all</button>
      </main>
    </div>
  </div>
  <script>
    import "../scripts/todo.js";
  </script>
</Layout>