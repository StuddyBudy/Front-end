<nav class="sticky mb-2 flex w-full justify-between shadow sm:flex">
    <a class="hover:bg-background-2 rounded p-2 transition" href="/">Home</a>

    <div class="flex justify-around gap-x-2">
        <a class="hover:bg-background-2 rounded border p-2" href="/gpa/step1">GPA</a>
        <a class="hover:bg-background-2 rounded border p-2" href="/todo">Todo</a>
        <a class="hover:bg-background-2 rounded border p-2" href="/cal">Calendar</a>
        <a class="hover:bg-background-2 rounded border p-2" href="/pass">Passwords</a>

        <select id="theme-toggle-web" class="bg-background-1 hover:bg-background-2 rounded border p-2">
            <option disabled selected>Theme:</option>
            <option value="system">System</option>
            <option value="dark">Dark</option>
            <option value="light">Light</option>
            <option value="rose-pine">Rosé Pine</option>
            <option value="nord">Nord</option>
            <option value="ehs">Eagles</option>
            <option value="catpuccin">Catpuccin</option>
        </select>
    </div>
</nav>

<nav class="bg-background-1 absolute flex h-full flex-col gap-2 shadow sm:hidden">
    <a class="hover:bg-background-2 rounded border p-2" href="/">Home</a>
    <a class="hover:bg-background-2 rounded border p-2" href="/gpa/step1">GPA</a>
    <a class="hover:bg-background-2 rounded border p-2" href="/todo">Todo</a>
    <a class="hover:bg-background-2 rounded border p-2" href="/cal">Calendar</a>
    <a class="hover:bg-background-2 rounded border p-2" href="/pass">Passwords</a>

    <select id="theme-toggle-mobile" class="bg-background-1 hover:bg-background-2 rounded border p-2">
        <option disabled selected>Theme:</option>
        <option value="system">System</option>
        <option value="dark">Dark</option>
        <option value="light">Light</option>
        <option value="rose-pine">Rosé Pine</option>
        <option value="nord">Nord</option>
        <option value="ehs">Eagles</option>
        <option value="catpuccin">Catpuccin</option>
    </select>
</nav>

<script>
    const web = document.getElementById("theme-toggle-web") as HTMLSelectElement;
    const mobile = document.getElementById("theme-toggle-mobile") as HTMLSelectElement;
    const savedTheme = localStorage.theme || "system";

    if (!web || !mobile) {
        console.error("Theme toggle elements not found.");
    } else {
        web.value = savedTheme;
        mobile.value = savedTheme;
    }

    function updateTheme(e: Event) {
        let value = savedTheme;
        if (e && e.target) {
            value = (e.target as HTMLSelectElement).value;
        } else {
            value = web.value;
        }

        localStorage.theme = value;
        web.value = value;
        mobile.value = value;

        if (value === "system") {
            if (window.matchMedia("(prefers-color-scheme: dark)").matches) {
                document.documentElement.setAttribute("data-theme", "dark");
            } else {
                document.documentElement.setAttribute("data-theme", "light");
            }
        } else {
            document.documentElement.setAttribute("data-theme", value);
        }
    }

    web.addEventListener("change", updateTheme);
    mobile.addEventListener("change", updateTheme);

    updateTheme(null as any);
</script>
